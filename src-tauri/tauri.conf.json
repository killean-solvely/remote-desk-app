{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Desk",
  "version": "0.5.3",
  "identifier": "com.remotedesk.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Remote Desk",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Secure SFTP browsing and rclone downloads",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "resources": {
      "resources/engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Remote Desk"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMUFDQjFCM0QwMjRGN0YKUldSL1R3STlHOHNhbmRSWWNqYURrWFZVbklKVXBBQXYwdjVBelFzMFAyQ0xMNWtRSTZTeFJ1Qm4K",
      "endpoints": [
        "https://rd.killean.me/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
